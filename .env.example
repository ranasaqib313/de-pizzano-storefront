# ==============================================================================
# DE PIZZANO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase project values.
#
# CRITICAL SECURITY RULES:
# - NEVER commit actual secret keys or credentials to version control.
# - SUPABASE_SERVICE_ROLE_KEY must NEVER have the NEXT_PUBLIC_ prefix and
#   must NEVER be used in client-side code.
# - .env.local is in .gitignore and must remain strictly uncommitted.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Free Tier Project — Singapore / Southeast Asia Region)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only Service Role Key (NEVER expose to frontend bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Restaurant Configuration Overrides (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RESTAURANT_PHONE="+92 318 2588631"
NEXT_PUBLIC_DEFAULT_DELIVERY_FEE=100

